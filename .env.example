# Copy to .env and fill in. .env is gitignored — never commit a real key.

# --- IBM ICA (IBM Consulting Advantage) ---
# The real host is an internal endpoint — keep it in .env (gitignored), not in here.
ICA_API_KEY=
ICA_BASE_URL=https://<your-ica-host>/ica/v1/chat-models
ICA_MODEL=claude-sonnet-5
ICA_INTEGRATION_ID=
ICA_EXTENSION_NAME=

# --- or any OpenAI-compatible endpoint ---
# GLASSBOX_LLM_URL=https://api.openai.com/v1
# GLASSBOX_LLM_KEY=
# GLASSBOX_LLM_MODEL=gpt-4o-mini

# off | record | replay        (default: off, and off is a fully working path)
GLASSBOX_LLM=off

# openai | ica-query | ica-messages | ica-invoke
# Leave unset and run `npm run llm:probe` to detect it.
# GLASSBOX_LLM_SHAPE=
