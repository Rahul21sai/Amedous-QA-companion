{
  "_doc": [
    "CANONICAL LOCATORS — the seed. The healer NEVER writes this file.",
    "",
    "engine/registry.json is live state: it accumulates fingerprints and healHistory as runs",
    "happen. This file is the source of truth for what each locator SHOULD be, and",
    "`run.js --baseline` restores primaries from here before recording fresh fingerprints.",
    "",
    "Without this, a rehearsal leaves the registry holding the previous heal, so the next",
    "baseline run starts already-broken, heals itself, and is not actually a baseline."
  ],
  "nav.shop": {
    "kind": "role",
    "primary": {
      "role": "link",
      "name": "Shop",
      "exact": true
    }
  },
  "nav.cart": {
